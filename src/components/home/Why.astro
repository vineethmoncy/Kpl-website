---
import Section from "../Section.astro";
import Reveal from "../Reveal.astro";
import Icon from "../Icon.astro";
import { t, tx, type Lang } from "../../i18n/utils";
interface Props { lang: Lang }
const { lang } = Astro.props;
const items = tx<{ title: string; text: string }[]>(lang, "home.why.items");
---

<Section id="why" tone="surface" title={t(lang, "home.why.title")}>
  <div class="grid gap-x-12 md:grid-cols-2">
    {items.map((it, i) => (
      <Reveal delay={(i % 2) * 60}>
        <div class="flex gap-4 border-t border-line py-6">
          <span class="mt-0.5 shrink-0 text-red-ink"><Icon name="check" size={28} /></span>
          <div>
            <h3>{it.title}</h3>
            <p class="mt-2 text-muted">{it.text}</p>
          </div>
        </div>
      </Reveal>
    ))}
  </div>
</Section>
