---
import Section from "./Section.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { t, localizedPath, type Lang } from "../i18n/utils";
import { site } from "../data/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Section tone="slate">
  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
    <div>
      <h2>{t(lang, "services.ctaTitle")}</h2>
      <p class="mt-3 text-lg text-white/85">{t(lang, "services.ctaText")}</p>
    </div>
    <div class="flex flex-col items-start gap-5 md:items-end">
      <a href={site.phoneHref} class="phone inline-flex min-h-11 items-center gap-3 font-head text-white no-underline">
        <Icon name="phone" size={36} />{site.phone}
      </a>
      <Button href={localizedPath(lang, "/contact/")} size="lg" class="cta-btn">{t(lang, "cta.discuss")}</Button>
    </div>
  </div>
</Section>

<style>
  .phone { font-size: clamp(30px, 6vw, 44px); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .phone:hover { text-decoration: underline; }
  :global(.cta-btn) { background: #fff; color: var(--slate); border-color: #fff; }
  :global(.cta-btn:hover) { background: var(--red-tint); border-color: var(--red-tint); }
</style>
