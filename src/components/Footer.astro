---
import { t, localizedPath, type Lang } from "../i18n/utils";
import { site } from "../data/site";
import { services } from "../data/services";
import { loc, type L } from "../data/types";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const nav = [
  ["home", "/"], ["services", "/services/"], ["experience", "/experience/"], ["about", "/about/"], ["contact", "/contact/"],
] as const;
const svc = services as unknown as { slug: string; title: L }[];
---

<footer class="bg-slate text-white foot">
  <div class="container-x" style="padding-block:56px 24px">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-head text-2xl font-bold">{site.name}</p>
        <p class="mt-3 text-white/85">{t(lang, "footer.tagline")}</p>
      </div>
      <div>
        <h2 class="fh">{t(lang, "footer.quickLinks")}</h2>
        <ul>
          {nav.map(([k, p]) => <li><a href={localizedPath(lang, p)}>{t(lang, `nav.${k}`)}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="fh">{t(lang, "footer.services")}</h2>
        <ul>
          {svc.map((s) => <li><a href={localizedPath(lang, `/services/${s.slug}/`)}>{loc(s.title, lang)}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="fh">{t(lang, "footer.contact")}</h2>
        <ul>
          <li><a href={site.phoneHref} class="ic"><Icon name="phone" size={20} />{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="ic"><Icon name="mail" size={20} /><span class="break-all">{site.email}</span></a></li>
          <li><a href={site.mapHref} class="ic" target="_blank" rel="noopener noreferrer"><Icon name="pin" size={20} />{loc(site.address, lang)}</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-white/25 pt-6 text-sm text-white/85 sm:flex-row sm:justify-between">
      <p>{t(lang, "footer.gstin")}: <span class="font-medium text-white">{site.gstin}</span></p>
      <p>© {new Date().getFullYear()} {site.name}. {t(lang, "footer.rights")}</p>
    </div>
  </div>
</footer>

<style>
  .fh { font-family: var(--font-head); font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 12px; }
  :global(body.lang-hi) .fh { font-family: var(--font-head-hi); }
  .foot ul { display: flex; flex-direction: column; }
  .foot a { color: #fff; text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; gap: 8px; }
  .foot a:hover { text-decoration: underline; }
  .foot a:focus-visible { outline-color: #fff; }
  .foot a.ic { align-items: flex-start; padding-block: 10px; }
  .foot a.ic :global(svg) { flex: none; margin-top: 3px; }
</style>
