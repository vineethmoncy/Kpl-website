---
import Base from "../../layouts/Base.astro";
import PageHeader from "../PageHeader.astro";
import Section from "../Section.astro";
import Icon from "../Icon.astro";
import ContactForm from "../ContactForm.astro";
import { t, type Lang } from "../../i18n/utils";
import { loc } from "../../data/types";
import { site } from "../../data/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const title = t(lang, "contact.title");
const sub = t(lang, "contact.sub");

const rows = [
  { icon: "phone", label: t(lang, "contact.phone"), value: site.phone, href: site.phoneHref },
  { icon: "whatsapp", label: t(lang, "contact.whatsapp"), value: site.phone, href: site.whatsappHref, external: true },
  { icon: "mail", label: t(lang, "contact.email"), value: site.email, href: `mailto:${site.email}` },
];
---

<Base title={`${title} | ${site.name}`} description={sub} lang={lang}>
  <PageHeader
    lang={lang}
    title={title}
    sub={sub}
    breadcrumb={[{ label: t(lang, "nav.home"), href: "/" }, { label: t(lang, "nav.contact") }]}
  />

  <Section tone="paper">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-2">
        <ul class="m-0 list-none border-b border-line p-0">
          {rows.map((r) => (
            <li class="flex gap-4 border-t border-line py-5">
              <span class="mt-1 shrink-0 text-red-ink"><Icon name={r.icon} size={26} /></span>
              <div class="min-w-0">
                <p class="m-0 text-sm uppercase tracking-wider text-slate">{r.label}</p>
                <a
                  href={r.href}
                  class="mt-1 inline-flex min-h-11 items-center break-all text-lg font-semibold"
                  {...r.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
                >{r.value}</a>
              </div>
            </li>
          ))}
          <li class="flex gap-4 border-t border-line py-5">
            <span class="mt-1 shrink-0 text-red-ink"><Icon name="pin" size={26} /></span>
            <div class="min-w-0">
              <p class="m-0 text-sm uppercase tracking-wider text-slate">{t(lang, "contact.address")}</p>
              <p class="m-0 mt-1 text-lg">{loc(site.address, lang)}</p>
              <a
                href={site.mapHref}
                class="mt-1 inline-flex min-h-11 items-center font-semibold"
                target="_blank"
                rel="noopener noreferrer"
              >{t(lang, "contact.map")}</a>
            </div>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <div class="rounded-lg border border-line bg-surface p-6 md:p-8">
          <h2>{t(lang, "contact.form.title")}</h2>
          <div class="mt-6">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </Section>
</Base>
